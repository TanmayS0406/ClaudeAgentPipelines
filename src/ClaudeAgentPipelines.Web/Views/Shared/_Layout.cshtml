@inject ClaudeAgentPipelines.Claude.ClaudeAccountService Claude
@using ClaudeAgentPipelines.Controllers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Claude Agent Pipelines</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Boards" asp-action="Index">
            <span class="brand-mark">&#10022;</span> Claude Agent Pipelines
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="nav">
                <a asp-controller="Boards" asp-action="Index">Boards</a>
                <a asp-controller="Pipelines" asp-action="Index">Pipelines</a>
                <a asp-controller="Runs" asp-action="Index">Runs</a>
                <a asp-controller="Azure" asp-action="Index">Azure</a>
                <a asp-controller="Subscription" asp-action="Index">Subscription</a>
                <a asp-controller="Billing" asp-action="Index">Billing</a>
                <a asp-controller="Account" asp-action="Claude">Claude</a>
            </nav>
            <div class="account">
                <span class="account-name" title="Signed in as @User.FindFirst(AccountController.UserNameClaim)?.Value">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-link">Sign out</button>
                </form>
            </div>
        }
    </header>

    <main class="container@(ViewData["Wide"] as bool? == true ? " container-wide" : "")">
        @if (User.Identity?.IsAuthenticated == true && ViewContext.RouteData.Values["action"] as string != "Claude"
             && !(await Claude.GetStatusAsync()).LoggedIn)
        {
            <div class="alert alert-error">
                Claude is not signed in on this computer, so pipelines cannot run.
                <a asp-controller="Account" asp-action="Claude">Sign in with Claude</a>
            </div>
        }
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-ok">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
