<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Claude Agent Pipelines</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Pipelines" asp-action="Index">
            <span class="brand-mark">&#10022;</span> Claude Agent Pipelines
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="nav">
                <a asp-controller="Pipelines" asp-action="Index">Pipelines</a>
                <a asp-controller="Runs" asp-action="Index">Runs</a>
            </nav>
            <div class="account">
                <span class="account-name" title="Signed in with Claude">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-link">Sign out</button>
                </form>
            </div>
        }
    </header>

    <main class="container">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-ok">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
