@model ClaudeViewModel
@{
    ViewData["Title"] = "Claude account";
    var status = Model.Status;
}

<section class="card login-card">
    <h1>Claude account</h1>
    <p class="muted">
        Pipelines run on your own Claude account through Claude Code on this computer.
        The app never sees your password or tokens - Claude Code signs in through your browser and keeps them.
    </p>

    @if (!status.CliFound)
    {
        <div class="alert alert-error">
            Claude Code is not installed on this computer (or not on PATH).
            Install it from <a href="https://claude.com/claude-code" target="_blank" rel="noopener">claude.com/claude-code</a>,
            or set <code>Claude:CliPath</code> in <code>appsettings.json</code>, then reload this page.
        </div>
    }
    else
    {
        <form id="claude-form" method="post">@Html.AntiForgeryToken()</form>

        @if (status.LoggedIn)
        {
            <p>
                Claude Code on this computer is signed in as <strong>@status.Account</strong>
                @if (status.SubscriptionType is not null)
                {
                    <span class="badge">@status.SubscriptionType</span>
                }
            </p>
        }
        else
        {
            <div class="alert alert-error">Claude is not signed in, so pipelines cannot run yet.</div>
        }

        <div class="login-actions">
            <button type="button" id="start-login" class="btn @(status.LoggedIn ? "btn-secondary" : "btn-primary btn-large")"
                    data-start-url="@Url.Action("StartLogin")" data-status-url="@Url.Action("Status")">
                @(status.LoggedIn ? "Use a different Claude account" : "Sign in with Claude")
            </button>
        </div>

        <p id="login-progress" class="login-progress" @(Model.LoginInProgress ? "" : "hidden")>
            <span class="spinner"></span>
            <span id="login-progress-text">
                A Claude Code window opened on this computer. Finish signing in in your browser - this page updates automatically.
            </span>
        </p>
        <p id="login-error" class="alert alert-error" hidden></p>
    }
</section>

@section Scripts {
    <script src="~/js/claude.js" asp-append-version="true"></script>
}
