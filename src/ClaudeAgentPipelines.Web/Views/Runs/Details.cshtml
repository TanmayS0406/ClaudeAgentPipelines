@model PipelineRun
@{
    ViewData["Title"] = "Run of " + Model.PipelineName;
    var status = Model.Status.ToString().ToLowerInvariant();
}

<div class="page-header">
    <h1>
        <a asp-controller="Pipelines" asp-action="Run" asp-route-id="@Model.PipelineId">@Model.PipelineName</a>
        <span id="run-status" class="status status-@status">@Model.Status</span>
    </h1>
    <div class="actions">
        <form id="cancel-form" asp-action="Cancel" asp-route-id="@Model.Id" method="post" hidden="@Model.IsFinished">
            <button type="submit" class="btn btn-danger">Cancel run</button>
        </form>
        <a class="btn btn-primary" asp-controller="Pipelines" asp-action="Run" asp-route-id="@Model.PipelineId">Run again</a>
    </div>
</div>

<p class="muted small">
    Started @Model.StartedAt.ToLocalTime().ToString("g") by @Model.StartedBy
</p>

<div id="run-error" class="alert alert-error" hidden="@(Model.Error is null || Model.Status == RunStatus.Cancelled)">@Model.Error</div>

<section class="card">
    <h2>Input</h2>
    <pre class="output">@Model.Input</pre>
</section>

<div id="run" data-events-url="@Url.Action("Events", new { id = Model.Id, after = Model.LastSeq })" data-finished="@Model.IsFinished.ToString().ToLowerInvariant()">
    @for (var i = 0; i < Model.Steps.Count; i++)
    {
        var step = Model.Steps[i];
        var stepStatus = step.Status.ToString().ToLowerInvariant();
        <section class="card step-card" data-status="@stepStatus" data-agent-id="@step.AgentId">
            <div class="agent-header">
                <span class="step">@(i + 1)</span>
                <h3>@step.Name</h3>
                @if (!string.IsNullOrWhiteSpace(step.Model))
                {
                    <span class="badge">@step.Model</span>
                }
                <span class="tokens muted small">@(step.OutputTokens is null ? "" : $"{step.InputTokens:N0} in / {step.OutputTokens:N0} out tokens")</span>
                <span class="status status-@stepStatus" data-role="status">@step.Status</span>
                <button type="button" class="btn btn-link" data-role="copy" title="Copy this agent's reply">Copy</button>
            </div>
            <ul class="activity" data-role="activity">
                @foreach (var activity in step.Activity)
                {
                    <li>&rsaquo; @activity</li>
                }
            </ul>
            <pre class="output" data-role="output">@step.Output</pre>
            <div class="alert alert-error" data-role="error" hidden="@(step.Error is null)">@step.Error</div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/run.js" asp-append-version="true"></script>
}
