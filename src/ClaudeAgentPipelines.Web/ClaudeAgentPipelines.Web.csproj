<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaudeAgentPipelines</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.26.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pipelines, uploaded agent files and run history live here at runtime. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Watch Remove="App_Data\**" />
  </ItemGroup>

</Project>
