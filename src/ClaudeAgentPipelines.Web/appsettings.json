{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5180" }
    }
  },
  "Claude": {
    "CliPath": "",
    "DefaultModel": "",
    "AgentTimeoutMinutes": 15
  },
  "Storage": {
    "DataFolder": "App_Data",
    "MaxFileBytes": 10485760,
    "MaxFilesPerAgent": 20,
    "AllowedFileExtensions": [
      ".txt", ".md", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml", ".html", ".htm", ".log",
      ".sql", ".cs", ".js", ".ts", ".py", ".java", ".go", ".rb", ".ps1", ".sh", ".ipynb",
      ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp"
    ]
  },
  "Security": {
    "AllowRemoteClients": false
  },
  "Azure": {
    "CliPath": ""
  },
  "Board": {
    "WorkspacesFolder": "",
    "AgentTimeoutMinutes": 40,
    "MaxTestRounds": 2,
    "MaxIntegrationTurns": 6,
    "MaxParallelFeaturesLimit": 6
  }
}
